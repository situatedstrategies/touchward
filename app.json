{
  "expo": {
    "name": "Touchward",
    "slug": "touchward",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "touchward",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#C41200",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Touchward reads your calendar so it can nudge you to tap right after an event ends. Nothing is written or uploaded."
        }
      ],
      "expo-background-task"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.situatedstrategies.touchward",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Touchward sends the reminders you schedule so you remember to tap."
      }
    },
    "android": {
      "package": "com.situatedstrategies.touchward",
      "permissions": ["android.permission.VIBRATE", "android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1f908ad7-e217-4c8b-b542-8b1f8328fe3d"
      }
    },
    "owner": "omaas"
  }
}
